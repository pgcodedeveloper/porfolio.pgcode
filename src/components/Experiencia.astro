---
import ItemExperiencia from './ItemExperiencia.astro'
import * as experienciaData from '../data/experiencia.md'

const EXPERIENCIA = experienciaData.frontmatter.experiencia || [];
---
<ol class="relative border-s border-gray-200 dark:border-gray-700 ml-3">                  
    {EXPERIENCIA?.map(exp =>(
        <ItemExperiencia experiencia={exp}/>
    ))}
</ol>